# =========================
# DigitalOcean (BE runtime)
# App → Settings → Environment Variables / Secrets
# =========================
PORT=8080
DB_PASSWORD=
JWT_SECRET=
# DB_URL=
# DB_USERNAME=
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# OpenRouter — AI quét hồ sơ NTD (dùng trong backend/.env khi chạy local)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview

# AWS S3 — upload CV/ảnh (backend/.env)
UPLOAD_STORAGE=s3
S3_BUCKET=
S3_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=


# =========================
# GitHub Actions (FE Pages)
# Settings → Secrets and variables → Actions → Variables
# =========================
# VITE_API_URL=https://<your-app>.ondigitalocean.app/api/v1
