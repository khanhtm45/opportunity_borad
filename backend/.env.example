# Backend — copy sang DigitalOcean App → Environment Variables
# (hoặc copy thành backend/.env cho chạy local: cp .env.example .env)

# --- Bắt buộc ---
PORT=8080
DB_PASSWORD=
JWT_SECRET=

# --- DB (optional nếu dùng default Supabase trong application.yml) ---
# DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0&preparedStatementCacheSize=0&defaultRowFetchSize=50&stringtype=unspecified
# DB_USERNAME=postgres.cmmypmpxisysrnqoqfdv

# --- Mail (optional — chưa dùng gửi mail thật thì để trống) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- OpenRouter AI (quét hồ sơ nhà tuyển dụng) ---
# Lấy key tại https://openrouter.ai/keys — dán vào đây
OPENROUTER_API_KEY=
# Model mặc định: Gemini 3 Flash Preview
OPENROUTER_MODEL=google/gemini-3-flash-preview
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_SECONDS=90

# --- AWS S3 (upload CV / ảnh / hồ sơ) ---
UPLOAD_STORAGE=s3
S3_BUCKET=
S3_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Không public bucket — file private + AES256. Link xem qua /api/v1/media/view?sig=…
# Production: URL API tuyệt đối để <img> trên GitHub Pages load được
# MEDIA_PUBLIC_BASE_URL=https://oyster-app-eleoo.ondigitalocean.app/api/v1
# Local (Vite proxy): để trống cũng được
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/api/v1

