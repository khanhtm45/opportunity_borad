# Backend — copy sang DigitalOcean App → Environment Variables
# (hoặc copy thành backend/.env cho chạy local: cp .env.example .env)

# --- Bắt buộc ---
PORT=8080
DB_PASSWORD=
JWT_SECRET=

# --- DB (optional nếu dùng default Supabase trong application.yml) ---
# DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0&preparedStatementCacheSize=0&defaultRowFetchSize=50&stringtype=unspecified
# DB_USERNAME=postgres.cmmypmpxisysrnqoqfdv

# --- Mail (optional — chưa dùng gửi mail thật thì để trống) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
