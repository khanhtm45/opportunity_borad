# Frontend — biến build-time (Vite)
# Local: copy thành frontend/.env  (không bắt buộc nếu dùng proxy /api)
# DO FE app (shark): set trên UI BUILD_TIME — không chỉ file này
# GitHub Pages: Settings → Variables → Actions → VITE_API_URL

# BE app riêng (oyster), không phải URL của FE (shark)
VITE_API_URL=https://oyster-app-eleoo.ondigitalocean.app/api/v1
# Chỉ dùng trên DO FE build; local/GitHub Pages thường không cần
# VITE_BASE_PATH=/

